# ============================================================
#  Neon Siege — Plantilla de variables de entorno
# ============================================================
# Este archivo muestra las variables que el backend (server/)
# espera. Copia su contenido en BACKEND/.env y ajusta los valores.
#
#   Linux / Mac :  cp env.example BACKEND/.env
#   Windows     :  copy env.example BACKEND\.env
# ============================================================

# Puerto donde escuchará el servidor Node.js/Express
PORT=4000

# --- Conexión a PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=tu_password_aqui
DB_NAME=neon_siege_db
